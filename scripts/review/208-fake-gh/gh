#!/usr/bin/env node
// Stand-in for the GitHub CLI in scripts/review/208.sh: one board issue o/onboard#1 with a PR, a
// sub-issue, a body and three comments in mixed API order. addComment appends to $FAKE_GH_STATE,
// so sending in the UI goes through server and "GitHub" without touching the real one.
import fs from 'fs';

const args = process.argv.slice(2);
const vars = {};
for (let i = 0; i < args.length; i++) {
  if (args[i] === '-f' || args[i] === '-F') {
    const [k, ...v] = args[++i].split('=');
    vars[k] = v.join('=');
  }
}
const q = vars.query || '';
const STATE = process.env.FAKE_GH_STATE;
const c = (id, author, body, createdAt) => ({ id, author: { login: author }, body, createdAt, url: `https://github.com/o/onboard/issues/1#${id}` });
const comments = fs.existsSync(STATE)
  ? JSON.parse(fs.readFileSync(STATE, 'utf8'))
  : [
      c('C2', 'mitte', 'zweiter Kommentar', '2026-10-02T10:00:00Z'),
      c('C1', 'alt', 'erster Kommentar', '2026-10-01T10:00:00Z'),
      c('C3', 'neu', 'dritter Kommentar', '2026-10-03T10:00:00Z'),
    ];

const page = (nodes) => ({ pageInfo: { hasNextPage: false, endCursor: null }, nodes });
const pr = { number: 5, url: 'https://github.com/o/onboard/pull/5', title: 'Fake-PR zu #1', state: 'OPEN', repository: { nameWithOwner: 'o/onboard' }, statusCheckRollup: { state: 'SUCCESS' } };
const issue = {
  id: 'PVTI_on',
  fieldValueByName: { optionId: 'bl' },
  content: {
    __typename: 'Issue', id: 'I_on', number: 1, title: 'Review #208', url: 'https://github.com/o/onboard/issues/1',
    state: 'OPEN', stateReason: null, updatedAt: '2026-10-03T10:00:00Z', closedAt: null,
    repository: { nameWithOwner: 'o/onboard' }, parent: null, subIssuesSummary: { total: 1, completed: 0 },
    labels: { nodes: [] }, milestone: null, assignees: { nodes: [] },
    closedByPullRequestsReferences: { nodes: [pr] }, comments: { nodes: comments },
  },
};
const status = { id: 'F', options: [{ id: 'bl', name: 'Backlog', color: 'GRAY' }] };

let data = {};
if (q.includes('items(first')) {
  data = { rateLimit: { cost: 1, remaining: 1 }, repositoryOwner: { projectV2: { id: 'PVT_1', title: 'B', field: status, items: page([issue]) } } };
} else if (q.includes('fragment M on ProjectV2')) {
  data = { repositoryOwner: { projectV2: { id: 'PVT_1', field: status } } };
} else if (q.includes('id labels(first:100')) {
  data = { repository: { id: 'R_1', labels: page([]), assignableUsers: page([]), milestones: page([]) } };
} else if (q.includes('node(id:$id){... on ProjectV2Item')) {
  data = { node: issue };
} else if (q.includes('addComment(input')) {
  comments.push(c(`C${comments.length + 1}`, 'review', vars.body, new Date().toISOString()));
  fs.writeFileSync(STATE, JSON.stringify(comments));
  data = { addComment: { commentEdge: { node: { id: 'new' } } } };
} else if (q.includes('comments(first:100')) {
  data = { node: { comments: page(comments) } };
} else if (q.includes('subIssues(first:100')) {
  data = { node: { body: 'Beschreibung des Fake-Issues', subIssues: page([{ id: 'I_sub', number: 2, title: 'Sub-Issue', state: 'OPEN', repository: { nameWithOwner: 'o/onboard' } }]) } };
}
process.stdout.write(JSON.stringify({ data }));
